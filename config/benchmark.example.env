# 実環境の値は benchmark.local.env に保存してください。
BENCHMARK_NAME=local-smoke
INPUT_MODE=video
PROTOCOL=webrtc
DURATION_SECONDS=60
TARGET_FPS=10
REPEATS=1

# 実 URL / IP / hostname / credential はこの example へ記載しないでください。
MEDIAMTX_BASE_URL=http://mediamtx.example.invalid
TRITON_GRPC_URL=triton.example.invalid:8001
POSE_MODEL_NAME=rtmpose
